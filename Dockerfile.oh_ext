# Runner image for claw-anything + OpenHarnessExtended (trial-in-container sandbox mode).
# Build via: scripts/build_oh_ext_image.sh
#
# Override registry at build time if needed:
#   docker build --build-arg REGISTRY=docker.io -f Dockerfile.oh_ext .
ARG REGISTRY=docker.m.daocloud.io
FROM ${REGISTRY}/python:3.11-slim

WORKDIR /opt/claw-anything

# ── claw-anything ────────────────────────────────────────────────────────────
# Install dependencies first (separate layer for better cache reuse).
COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --no-cache-dir \
    && rm /tmp/requirements.txt

# Install claw-anything package (src/ + mock_services/ copied by build script).
COPY claw-anything/pyproject.toml /opt/claw-anything/pyproject.toml
COPY claw-anything/src /opt/claw-anything/src
COPY claw-anything/mock_services /opt/claw-anything/mock_services
RUN pip install -e /opt/claw-anything \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --no-cache-dir

# ── OpenHarnessExtended ──────────────────────────────────────────────────────
# Only source files needed; node_modules / build / benchmark excluded by build script.
COPY oh-ext/pyproject.toml /opt/oh-ext/pyproject.toml
COPY oh-ext/README.md /opt/oh-ext/README.md
COPY oh-ext/src /opt/oh-ext/src
COPY oh-ext/ohmo /opt/oh-ext/ohmo
COPY oh-ext/frontend/terminal/package.json /opt/oh-ext/frontend/terminal/package.json
COPY oh-ext/frontend/terminal/tsconfig.json /opt/oh-ext/frontend/terminal/tsconfig.json
COPY oh-ext/frontend/terminal/src /opt/oh-ext/frontend/terminal/src
RUN pip install -e /opt/oh-ext \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --no-cache-dir

# ── Build-time patches ───────────────────────────────────────────────────────
# Shared with claw-anything-oh — the patched anchors are identical in vanilla OH
# and the OH-Ext fork. Run after the editable install so ``import openharness``
# resolves to /opt/oh-ext/src.
#   - patch_system_prompt_suffix.py → append ``CLAW_SYSTEM_PROMPT_SUFFIX`` (the
#     activity-logs section, set per-trial by OpenHarnessAgent._build_oh_env).
#   - patch_emit_system_prompt.py   → emit the final system prompt as a
#     stream-json event so claw's OH adapter records it for trace export.
COPY oh/patch_system_prompt_suffix.py /tmp/patch_system_prompt_suffix.py
COPY oh/patch_emit_system_prompt.py   /tmp/patch_emit_system_prompt.py
RUN python /tmp/patch_system_prompt_suffix.py \
 && python /tmp/patch_emit_system_prompt.py \
 && rm /tmp/patch_system_prompt_suffix.py /tmp/patch_emit_system_prompt.py

# ── adb ──────────────────────────────────────────────────────────────────────
# Copy binary directly from host — no apt-get layer, same version as host.
# Build script places the binary at <context>/adb before docker build.
COPY adb /usr/local/bin/adb
RUN chmod +x /usr/local/bin/adb

ENTRYPOINT ["claw-anything"]
